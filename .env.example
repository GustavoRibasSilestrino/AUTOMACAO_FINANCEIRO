# Copie para ".env" e preencha (Supabase > Project Settings > API).
# Estes valores são embutidos no app na hora do build: rode `npm run dist` DEPOIS de preencher.
# Use a chave "anon" / "publishable". NUNCA coloque a chave "service_role" aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA-CHAVE-ANON

# Domínio dos e-mails dos 4 usuários de setor (ex.: financeiro@painel.app)
VITE_EMAIL_DOMAIN=painel.app
